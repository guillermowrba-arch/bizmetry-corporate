// src/index.js

const angular = window.angular;
if (!angular) {
  throw new Error('AngularJS no está disponible en window. Verifica que los CDNs de Angular carguen antes del bundle.');
}

console.log ('ARRANCANDO!');
const app = angular.module('bizmetryApp', [
  'ngRoute',
  'ngAnimate',
  'ngAria',
  'ngMessages',
  'ngMaterial',
  'ngclipboard'
]);

console.log('AngularJS app initialized 1', app);

import './common/ConfigurationService';
import './common/filters';
import './login/AuthService';
import './login/loginController';
import './register/register';
import './activation/activationController';
import './home/HomeController';

import './referenceData/reference-data-service';
import './datasources/DatasourceService';
import './datasources/DatasourceDialogController';
import './datasources/DatasourceEditDialogController';
import './agents/AgentConfigService';
import './agents/AgentLogsService';
import './agents/TelemetryAgentService';
import './agents/AgentsPanelController';
import './agents/DownloadDialogController';
import './agents/LogDetailDialogController';
import './agents/AgentConfigDialogController';
import './agents/AgentLogsDialogController';
import './agents/AgentStatusPill';
import './profile/ProfileService';
import './profile/profile-details-dialog.controller';
import './template/TemplateInstanceService';
import './template/view-template-dialog-controller';
import './template/EditTemplateDialogController';
import './template/ResourceAttributesDialogController';
import './template/ResourceAttributesDialogViewCtrl';
import './template/ImportResourcesDialogController';
import './notifications/NotificationsService';
import './notifications/NotificationsDialogController';
import './jobs/jobService';
import './jobs/JobDefinitionsDialogController';
import './jobs/JobInstancesDialogController';

import './landing/LandingController';

angular.module('bizmetryApp')
  .service('ConfigurationService', ConfigurationService)
  .service('AuthService', AuthService)
  .controller('LoginController', LoginController)
  .controller('HomeController', HomeController)
  .controller('ActivationController', ActivationController)
  .controller('RegisterController', RegisterController)
  .service('DatasourceService', DatasourceService)
  .controller('DatasourceDialogController', DatasourceDialogController)
  .controller('DatasourceEditDialogController', DatasourceEditDialogController)
  .service('AgentConfigService', AgentConfigService)
  .service('AgentLogsService', AgentLogsService)
  .controller('AgentsPanelController', AgentsPanelController)
  .controller('DownloadDialogController', DownloadDialogController)
  .controller('LogDetailDialogController', LogDetailDialogController)
  .controller('AgentConfigDialogController', AgentConfigDialogController)
  .controller('AgentLogsDialogController', AgentLogsDialogController)
  .controller('AgentStatusPill', AgentStatusPill)
  .service('ProfileService', ProfileService)
  .controller('ProfileDetailsDialogController', ProfileDetailsDialogController)
  .service('TemplateInstanceService', TemplateInstanceService)
  .controller('ViewTemplateDialogController', ViewTemplateDialogController)
  .controller('EditTemplateDialogController', EditTemplateDialogController)
  .controller('ResourceAttributesDialogController', ResourceAttributesDialogController)
  .controller('ResourceAttributesDialogViewCtrl', ResourceAttributesDialogViewCtrl)
  .controller('ImportResourcesDialogController', ImportResourcesDialogController)
  .service('NotificationsService', NotificationsService)
  .controller('NotificationsDialogController', NotificationsDialogController)
  .service('JobService', JobService)
  .controller('JobDefinitionsDialogController', JobDefinitionsDialogController)
  .controller('JobInstancesDialogController', JobInstancesDialogController);

  console.log('AngularJS app initialized 2', app);
export default app;

